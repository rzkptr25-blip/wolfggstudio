# GEMINI_API_KEY: Required for Gemini AI API calls (configure real key via Secrets / Cloud Run env vars).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted (used for Midtrans webhooks & Bridge Agent).
APP_URL="http://localhost:3000"

# SESSION_SECRET: Secret string for signing session cookies/tokens.
SESSION_SECRET="change-this-to-a-long-random-secret"

# MIDTRANS_SERVER_KEY: Server Key from Midtrans Dashboard (configure real key via Secrets / Cloud Run env vars).
MIDTRANS_SERVER_KEY=""

# MIDTRANS_CLIENT_KEY: Client Key from Midtrans Dashboard (configure real key via Secrets / Cloud Run env vars).
MIDTRANS_CLIENT_KEY=""

# MIDTRANS_IS_PRODUCTION: Set to "true" for Midtrans Production, or "false" for Sandbox.
MIDTRANS_IS_PRODUCTION="false"

# PORT: HTTP & WebSocket server port (default 3000).
PORT="3000"

# DATA_DIR: Optional persistent volume path for SQLite database, reference images, and rendered MP4s.
DATA_DIR="./data"

# COMFYUI_TUNNEL_URL: Optional default public tunnel URL for local ComfyUI (e.g. https://comfy.example.com).
COMFYUI_TUNNEL_URL=""

# COMFYUI_WORKER_TOKEN: Optional static secret token for the local WebSocket Bridge Agent.
COMFYUI_WORKER_TOKEN=""
